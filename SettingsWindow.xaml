<Window x:Class="PCCast2TV.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Cast2TV" Background="#03070B" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">

    <Window.Resources>
        <!-- A thin line between sections, in the theme's dark shade -->
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="2" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Margin" Value="2,10,2,0" />
            <Setter Property="Background" Value="{DynamicResource Dim}" />
        </Style>
    </Window.Resources>

    <Border Padding="28,24,28,24">
        <StackPanel>
        <StackPanel Orientation="Horizontal">
        <StackPanel Width="380">
            <TextBlock Style="{StaticResource Label}" FontSize="24" Foreground="{DynamicResource Main}" Text="SETTINGS" />
            <TextBlock Style="{StaticResource Label}" FontSize="16" Foreground="{DynamicResource Second}" Margin="0,18,0,10" Text="THEME COLOR" />
            <!-- 4 over 4, lightest to darkest; the picked one has a ring and a tick -->
            <UniformGrid x:Name="Swatches" Columns="4" Rows="2" />
            <!-- On the same 4 columns: RANDOM rolls a new color, SAVE keeps it as MY COLOR (just one; a new save replaces it), CLOSE -->
            <UniformGrid x:Name="Own" Columns="4" Margin="0,4,0,0" />
            <Border Style="{StaticResource Divider}" />
            <TextBlock Style="{StaticResource Label}" FontSize="16" Foreground="{DynamicResource Second}" Margin="0,18,0,10" Text="WINDOW LOOK" />
            <UniformGrid x:Name="LookPills" Columns="4" />
            <Border Style="{StaticResource Divider}" />
            <TextBlock Style="{StaticResource Label}" FontSize="16" Foreground="{DynamicResource Second}" Margin="0,18,0,6" Text="STREAM CONTROLLER" />
            <TextBlock Style="{StaticResource Sentence}" FontSize="16" Foreground="{DynamicResource Soft}" TextWrapping="Wrap" Margin="4,0,4,10"
                       Text="Watches how well your TV keeps up, and lowers or raises the cast's data rate to keep the picture smooth. For TVs with Chromecast built in. Works right away, even during a cast." />
            <UniformGrid x:Name="ControllerPills" Columns="4" />
        </StackPanel>

        <!-- The Roku remote: a line in the theme color from the note to the OK button -->
        <StackPanel Margin="36,0,0,0">
            <TextBlock Style="{StaticResource Label}" FontSize="16" Foreground="{DynamicResource Second}" Margin="0,48,0,10" Text="ROKU REMOTE" />
            <Grid Width="444" Height="430">
                <Image Source="Images/roku-remote.png" Width="230" Height="430" HorizontalAlignment="Left" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="OkNote" Width="186" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="258,148,0,0"
                           Style="{StaticResource Sentence}" FontSize="16" Foreground="{DynamicResource Soft}" TextWrapping="Wrap"
                           Text="Pressing the OK button on the remote during video playback, will pause the video. This will allow you to grab a snack or something to drink. Press the OK button again to resume video playback." />
                <Canvas IsHitTestVisible="False">
                    <Line X1="250" Y1="234" X2="133" Y2="234" Stroke="{DynamicResource Main}" StrokeThickness="2" />
                    <Ellipse Canvas.Left="91" Canvas.Top="213" Width="42" Height="42" Stroke="{DynamicResource Main}" StrokeThickness="2" />
                </Canvas>
            </Grid>
        </StackPanel>
        </StackPanel>

        <!-- Across the bottom, under both sides, centered: the version and GitHub, the log folder, then DONATE -->
        <Border Style="{StaticResource Divider}" Margin="2,16,2,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <TextBlock x:Name="VersionText" Style="{StaticResource Label}" FontSize="16" Foreground="{DynamicResource Soft}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Button Width="150" Height="30" Style="{StaticResource OutlinePill}" ToolTip="Opens the app's page on GitHub in your browser" Click="GitHub_Click">
                <TextBlock FontSize="14" Text="GITHUB PAGE" />
            </Button>
            <TextBlock Style="{StaticResource Label}" FontSize="16" Foreground="{DynamicResource Soft}" VerticalAlignment="Center" Margin="56,0,14,0" Text="REPORTING A PROBLEM?" />
            <Button Width="150" Height="30" Style="{StaticResource OutlinePill}" ToolTip="Opens the folder with debug.log in it, so you can add it to an issue or feedback on GitHub" Click="LogFolder_Click">
                <TextBlock FontSize="14" Text="OPEN LOG FOLDER" />
            </Button>
            <Button Width="120" Height="30" Margin="56,0,0,0" Style="{StaticResource OutlinePill}" ToolTip="Opens PC Cast2TV's Ko-fi page in your browser" Click="Donate_Click">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24"><Path Style="{StaticResource PillIcon}" Data="{StaticResource IcoHeart}" /></Canvas>
                    </Viewbox>
                    <TextBlock FontSize="14" Text="DONATE" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
        </StackPanel>
    </Border>
</Window>
