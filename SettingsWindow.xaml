<Window x:Class="PCCast2TV.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Cast2TV" Background="#03070B" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">

    <Border Padding="28,24,28,24">
        <StackPanel Width="380">
            <TextBlock Style="{StaticResource Label}" FontSize="24" Foreground="{DynamicResource Main}" Text="SETTINGS" />
            <TextBlock Style="{StaticResource Label}" FontSize="16" Foreground="{DynamicResource Second}" Margin="0,18,0,10" Text="THEME COLOR" />
            <!-- 4 over 4, lightest to darkest; the picked one has a ring and a tick -->
            <UniformGrid x:Name="Swatches" Columns="4" Rows="2" />
            <!-- On the same 4 columns: RANDOM rolls a new color, SAVE keeps it as MY COLOR (just one; a new save replaces it), CLOSE -->
            <UniformGrid x:Name="Own" Columns="4" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Label}" FontSize="16" Foreground="{DynamicResource Second}" Margin="0,18,0,6" Text="STREAM CONTROLLER" />
            <TextBlock Style="{StaticResource Sentence}" FontSize="16" Foreground="{DynamicResource Soft}" TextWrapping="Wrap" Margin="4,0,4,10"
                       Text="Watches how well your TV keeps up, and lowers or raises the cast's data rate to keep the picture smooth. For TVs with Chromecast built in. Works right away, even during a cast." />
            <UniformGrid x:Name="ControllerPills" Columns="4" />
            <TextBlock Style="{StaticResource Label}" FontSize="16" Foreground="{DynamicResource Second}" Margin="0,18,0,10" Text="ABOUT" />
            <Grid>
                <TextBlock x:Name="VersionText" Style="{StaticResource Label}" FontSize="16" Foreground="{DynamicResource Soft}" VerticalAlignment="Center" Margin="4,0,0,0" />
                <Button Width="150" Height="30" HorizontalAlignment="Right" Margin="0,0,4,0" Style="{StaticResource OutlinePill}" ToolTip="Opens the app's page on GitHub in your browser" Click="GitHub_Click">
                    <TextBlock FontSize="14" Text="GITHUB PAGE" />
                </Button>
            </Grid>
            <Grid Margin="0,8,0,0">
                <TextBlock Style="{StaticResource Label}" FontSize="16" Foreground="{DynamicResource Soft}" VerticalAlignment="Center" Margin="4,0,0,0" Text="REPORTING A PROBLEM?" />
                <Button Width="150" Height="30" HorizontalAlignment="Right" Margin="0,0,4,0" Style="{StaticResource OutlinePill}" ToolTip="Opens the folder with debug.log in it, so you can add it to an issue or feedback on GitHub" Click="LogFolder_Click">
                    <TextBlock FontSize="14" Text="OPEN LOG FOLDER" />
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
