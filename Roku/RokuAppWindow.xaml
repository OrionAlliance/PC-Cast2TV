<Window x:Class="PCCast2TV.RokuAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Cast2TV" Background="#03070B" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">

    <Border Padding="28,24,28,24">
        <StackPanel Width="560">
            <TextBlock x:Name="TitleText" Style="{StaticResource Label}" FontSize="24" Foreground="{DynamicResource Main}" TextWrapping="Wrap" />
            <TextBlock Margin="0,14,0,0" Style="{StaticResource Sentence}" FontSize="18" Foreground="{DynamicResource Soft}" TextWrapping="Wrap"
                       Text="To play your PC on this Roku, add the free PC Cast2TV app to it:" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Image Source="/Images/pc-cast2tv-roku.png" Width="128" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Style="{StaticResource Label}" FontSize="18" Foreground="{DynamicResource Main}" Text="PC CAST2TV FOR ROKU" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Sentence}" FontSize="16" Foreground="{DynamicResource Soft}" TextWrapping="Wrap"
                               Text="Free in the Roku Channel Store. Click ADD PC CAST2TV and its page opens on the TV, then press OK on the Roku remote to add it." />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Sentence}" FontSize="16" Foreground="{DynamicResource Second}" TextWrapping="Wrap"
                               Text="With it, the OK button on the Roku remote pauses or plays a video on the PC." />
                    <Button x:Name="AddAppBtn" Width="150" Height="30" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource OutlinePill}"
                            ToolTip="Opens PC Cast2TV's page in the Roku Channel Store on the TV" Click="AddApp_Click">
                        <TextBlock FontSize="14" Text="ADD PC CAST2TV" />
                    </Button>
                    <!-- After a press: what to do on the TV, or the Search way if the Roku turned it down -->
                    <TextBlock x:Name="AppResult" Margin="0,8,0,0" Style="{StaticResource Sentence}" FontSize="16" Foreground="{DynamicResource Main}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- Same size as ADD PC CAST2TV -->
            <Button Width="150" Height="30" Margin="0,22,0,0" HorizontalAlignment="Right" Style="{StaticResource Pill}" Background="{DynamicResource Main}"
                    IsDefault="True" IsCancel="True">
                <TextBlock FontSize="14" Text="OK" />
            </Button>
        </StackPanel>
    </Border>
</Window>
