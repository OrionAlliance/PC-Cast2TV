<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PCCast2TV">
    <!-- Shared look for every window, in CYAN (the default); ThemeColors swaps the colors, which every part follows. -->
    <SolidColorBrush x:Key="Main" Color="#3CCBF4" />
    <SolidColorBrush x:Key="Soft" Color="#A8E6FA" />
    <SolidColorBrush x:Key="Second" Color="#4F9FC4" />
    <SolidColorBrush x:Key="Enc" Color="#6A98AC" />
    <SolidColorBrush x:Key="Peak" Color="#662D91" />
    <SolidColorBrush x:Key="Dim" Color="#0E2C3A" />
    <SolidColorBrush x:Key="DimText" Color="#34505E" />
    <SolidColorBrush x:Key="Ink" Color="#03070B" />
    <local:PillRadius x:Key="PillRadius" /> <!-- pill ends that stay round at any height -->

    <Geometry x:Key="IcoWifi">M10.6,17.8 A1.4,1.4 0 1,0 13.4,17.8 A1.4,1.4 0 1,0 10.6,17.8 M8.46,14.26 A5,5 0 0,1 15.54,14.26 M5.64,11.44 A9,9 0 0,1 18.36,11.44 M2.81,8.61 A13,13 0 0,1 21.19,8.61</Geometry>
    <Geometry x:Key="IcoPc">M3,4 H21 V16 H3 Z M12,16 V19.5 M7.5,20 H16.5</Geometry>
    <Geometry x:Key="IcoBookmark">M6,3 H18 V21 L12,16.5 L6,21 Z</Geometry>
    <Geometry x:Key="IcoDice">M6,3 H18 A3,3 0 0 1 21,6 V18 A3,3 0 0 1 18,21 H6 A3,3 0 0 1 3,18 V6 A3,3 0 0 1 6,3 Z M8.6,8 A0.6,0.6 0 1 0 7.4,8 A0.6,0.6 0 1 0 8.6,8 Z M12.6,12 A0.6,0.6 0 1 0 11.4,12 A0.6,0.6 0 1 0 12.6,12 Z M16.6,16 A0.6,0.6 0 1 0 15.4,16 A0.6,0.6 0 1 0 16.6,16 Z</Geometry>
    <!-- Settings cog, filled: 8 teeth around a round hole -->
    <Geometry x:Key="IcoCog">F0 M20.11,9.83 L23.05,10.15 L23.05,13.85 L20.11,14.17 L19.27,16.20 L21.12,18.50 L18.50,21.12 L16.20,19.27 L14.17,20.11 L13.85,23.05 L10.15,23.05 L9.83,20.11 L7.80,19.27 L5.50,21.12 L2.88,18.50 L4.73,16.20 L3.89,14.17 L0.95,13.85 L0.95,10.15 L3.89,9.83 L4.73,7.80 L2.88,5.50 L5.50,2.88 L7.80,4.73 L9.83,3.89 L10.15,0.95 L13.85,0.95 L14.17,3.89 L16.20,4.73 L18.50,2.88 L21.12,5.50 L19.27,7.80 Z M15.6,12 A3.6,3.6 0 1 0 8.4,12 A3.6,3.6 0 1 0 15.6,12 Z</Geometry>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Sentences: the same font at its normal width and weight, easier to read than the condensed titles. -->
    <Style x:Key="Sentence" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="FontStretch" Value="Normal" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Icon inside a pill: draws in the button's own text color. -->
    <Style x:Key="PillIcon" TargetType="Path">
        <Setter Property="StrokeThickness" Value="1.9" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!-- Text beside a pill icon: an even box centered in the pill, nudged down because Bahnschrift capitals sit high in their line. -->
    <Style x:Key="PillLabel" TargetType="TextBlock">
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransform">
            <Setter.Value><TranslateTransform Y="1.375" /></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Second}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PillRadius}}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Dim}" />
                            <Setter TargetName="Face" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource DimText}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An action next to color pills: a ring in the theme color with a dark middle, so a filled pill always means a color. -->
    <Style x:Key="OutlinePill" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Foreground" Value="{DynamicResource Main}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="Transparent" BorderBrush="{DynamicResource Main}" BorderThickness="2"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PillRadius}}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Dim}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Dim}" />
                            <Setter Property="Foreground" Value="{DynamicResource DimText}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Bare" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A device row in the hidden devices list: a pill with a check box; checked lights it up in the theme's color. -->
    <Style x:Key="PickRow" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Second}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Pill" Height="52" CornerRadius="26" BorderThickness="2" BorderBrush="{DynamicResource Second}" Background="Transparent">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="22" Height="22" CornerRadius="5" BorderThickness="2" BorderBrush="{DynamicResource Second}"
                                    VerticalAlignment="Center" Margin="0,0,14,0">
                                <Path x:Name="Tick" Data="M4,11 L9,16 L18,6" Stretch="Uniform" Margin="3" Stroke="{DynamicResource Ink}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Main}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Main}" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Main}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Main}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
