<Window x:Class="PCCast2TV.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Cast2TV" Background="#03070B" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">

    <Border Padding="28,24,28,24">
        <StackPanel Width="440">
            <TextBlock Style="{StaticResource Label}" FontSize="24" Foreground="{DynamicResource Main}" Text="UPDATE READY" />
            <TextBlock x:Name="BodyText" Margin="0,14,0,0" Style="{StaticResource Label}" FontSize="18" Foreground="{DynamicResource Soft}" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Margin="0,16,0,0" Style="{StaticResource Label}" FontSize="16" Foreground="{DynamicResource Second}" TextWrapping="Wrap" Visibility="Collapsed" />
            <ProgressBar x:Name="Progress" Height="6" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" BorderThickness="0"
                         Foreground="{DynamicResource Main}" Background="{DynamicResource Dim}" />
            <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Width="150" Style="{StaticResource Pill}" IsCancel="True">
                    <TextBlock Text="NOT NOW" />
                </Button>
                <Button Width="150" Margin="14,0,0,0" Style="{StaticResource Pill}" Background="{DynamicResource Main}" IsDefault="True" Click="Update_Click">
                    <TextBlock x:Name="UpdateLabel" Text="UPDATE" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
