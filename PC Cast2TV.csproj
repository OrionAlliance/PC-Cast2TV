<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PCCast2TV</RootNamespace>
    <AssemblyName>PC Cast2TV</AssemblyName>
    <Version>0.4.16</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- The PC's folder path stays out of the exe: build paths read as a neutral name -->
    <PathMap>$(MSBuildProjectDirectory)=PCCast2TV</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Roku App\**" />
    <!-- Builds holds test copies, design mockups and test tools: none of it goes into the app -->
    <Page Remove="Builds\**" />
    <Compile Remove="Builds\**" />
    <None Remove="Builds\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\pc-cast2tv-roku.png" />
    <Resource Include="Images\roku-remote.png" />
    <!-- REPORT A PROBLEM's address: a file only on the developer's PC (git skips Private), built into the exe when it's there -->
    <EmbeddedResource Include="Private\report-address.txt" LogicalName="report-address" Condition="Exists('Private\report-address.txt')" />
    <None Remove="Private\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="System.Management" Version="11.0.0" /> <!-- Windows Security Center: the security software line in the log -->
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

</Project>
